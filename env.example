R2_ACCESS_KEY_ID=87ccb6169189c8547df2d4533098d501
R2_SECRET_ACCESS_KEY=5803b4a0bd17d07a19164aefc1a7b7636244380fcf4d48fb2e159e1008c2aa34
R2_BUCKET_NAME=flashfire-storage
R2_PUBLIC_URL=https://pub-9122bde92eac495f8beda15ee45552dd.r2.dev/test

# Frontend Configuration
VITE_API_BASE_URL=https://your-backend-api.com
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_CLOUD_PRESET=your-cloudinary-upload-preset
VITE_CLOUDINARY_CLOUD_PRESET_PDF=your-cloudinary-pdf-preset

# OpenAI Configuration (Backend)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# SpeedyApply extension "Ask AI" (gpt-4o-mini). Separate key so its spend is easy to track.
auto_fill_chatgpt_API=your-openai-api-key
# SpeedyApply shared learning: daily merge of every client's learned label aliases.
# SPEEDYAPPLY_LEARNING_CRON=30 3 * * *        # IST
# SPEEDYAPPLY_LEARNING_MIN_CLIENTS=3          # distinct clients that must agree
# PDF server SpeedyApply uses to turn a job card's optimized resume into a PDF.
# Same server as the dashboard's VITE_PDF_SERVER_URL. Unset means this default.
# PDF_SERVER_URL=https://pdf-resume-pro.onrender.com

# ---- Second-stage screening (secondJudgeWorker) ----
# Re-judges every extension-pushed job against the REAL employer-site text.
# A DB-polled worker (no Redis) opens job.joblink via the scraper, scrapes the
# full posting, and re-grades it on LOCATION + FRESHNESS with the client profile.
#   • a CLOSED / EXPIRED posting is moved to the "removed by AI" column at once;
#   • a LOCATION mismatch is only FLAGGED — the job stays put for operator review;
#   • passes and un-screenable jobs are kept.
SECOND_JUDGE_ENABLED=true                 # set false to disable the worker
SECOND_JUDGE_THRESHOLD=50                 # min grade (0-100) to keep a job
SECOND_JUDGE_POLL_INTERVAL_MS=10000       # idle poll cadence
SECOND_JUDGE_DELAY_BETWEEN_JOBS_MS=2000   # gap between consecutive jobs
SECOND_JUDGE_CONCURRENCY=6                # jobs screened in parallel (scraper has ~6 slots)
SECOND_JUDGE_MAX_ATTEMPTS=3               # retries before failing OPEN (kept, 'skipped')
SECOND_JUDGE_MIN_JD_CHARS=200             # below this the scrape is treated as a failure
SECOND_JUDGE_SCRAPER_TIMEOUT_MS=45000     # scraper /extract request timeout
SECOND_JUDGE_OPENAI_TIMEOUT_MS=30000      # grader request timeout
SECOND_JUDGE_AUTO_REMOVE_ENABLED=true     # false → stale postings are flagged, not removed
# NOTE: the freshness window is NOT configurable here. A posting older than 3 days
# is expired and is moved to the Removed column. That is product policy, so it
# lives in code as STALE_POSTING_DAYS in Utils/secondJudgePrompt.js — the same
# constant the grader's worked examples are generated from, so the prompt and the
# deterministic gate can never disagree about what "expired" means.
SECOND_JUDGE_REQUEUE_LEGACY_FLAGS=true    # one-shot re-screen of pre-upgrade freshness flags
SECOND_JUDGE_AUDIT_LEGACY_REMOVALS=true  # boot-time READ-ONLY count of jobs the old 24h sweep removed
# OPENAI_JUDGE_MODEL=gpt-4o-mini          # optional override (defaults to OPENAI_MODEL)

# Scraper service (Playwright text extractor). Must match the extension's
# exports.js SCRAPER_BASE_URL. EXTRACT_PATH matches SCRAPER_ENDPOINTS.EXTRACT_INFO.
SCRAPER_BASE_URL=http://77.237.239.34:8092
SCRAPER_EXTRACT_PATH=/extract/infor=

# Google OAuth Configuration
# REQUIRED for Google Sign-In. GOOGLE_CLIENT_ID is the audience the backend
# checks on every Google ID token; if it is unset, /google-oauth refuses to run
# (leaving it blank would silently disable the aud check and accept tokens
# minted by any third-party Google OAuth client). It must match the frontend's
# VITE_GOOGLE_OAUTH_CLIENT_ID exactly.
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-api.com/gmail/auth/google/callback

# REQUIRED to create accounts. POST /api/clients/register rejects every request
# that does not present this value in an `x-admin-key` header, and returns 503
# if the variable is unset. Sign-in only works for accounts that already exist,
# so account creation is deliberately admin-only.
ADMIN_REGISTRATION_KEY=generate-with-openssl-rand-hex-32

# Gate for the Operations > Client Reminders routes (x-ops-key header), and
# for the Flashfire Autopilot's own routes: POST /autopilot/runs,
# POST /autopilot/queue/claim, POST /autopilot/queue/:id/finish and the
# /autopilot/creds/* credential store.
# REQUIRED: without it every /operations/reminders/* route answers 503.
# There is deliberately no default - the value must never be a constant that
# ships inside the frontend bundle. Generate with: openssl rand -hex 32
#
# NOTE Middlewares/RequireOpsKey.js still falls back to a built-in constant
# when this is unset, which is how the live autopilot authenticates today. The
# moment you set a real value here you must also set "opsKey" in the
# autopilot's /opt/FlashfireAutopilot/config.json to the same value, or it
# starts getting 401s and silently records no runs.
#
# The portal-facing autopilot routes (the Auto Extension report's reads, plus
# POST /autopilot/queue and .../cancel behind its Scrape button) are NOT gated
# by this, precisely so the key never has to reach a browser bundle.
OPS_SECRET_KEY=generate-with-openssl-rand-hex-32

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Logging
LOG_LEVEL=info

# ---- Scrape-cost Discord notifier ----
# Webhook URL the backend POSTs to when today's cumulative extension scrape
# count crosses each 5000-job milestone (5k, 10k, 15k, …). Get one in your
# Discord channel → Edit Channel → Integrations → Webhooks → New Webhook
# → Copy URL. Leave blank to disable.
DISCORD_SCRAPE_WEBHOOK_URL=

# Cost is MEASURED, not estimated. Every LLM call records the token counts the
# provider actually reported (Utils/aiUsage.js → AiUsageDaily) and the milestone
# embed prices those. Stage-1 judge batches run inside the extension, which
# reports its usage via ExtensionSessionStat.modelStats.
#
# NOTHING about cost is configurable here. There are NO env vars for it — not
# pricing, not the FX rate, not batch size, not the fallback token estimates.
# These were removed on purpose: an env-tunable cost constant is exactly how the
# old 2.3x under-report survived, with the correct value sitting in this file
# while production silently ran a different code default. Cost math is
# measurement, not deployment config, so it lives in code where a change shows
# up in a diff and gets reviewed:
#
#   Utils/aiRateCard.js       per-model $/1M rates (incl. cached-input rate),
#                             and the fixed ₹94/USD display rate
#   Utils/scrapeCostNotifier.js  batch size, the hardcoded gpt-4o-mini judge
#                             model, and the fallback-only token estimates
#
# These vars are no longer read and can be deleted from your environment:
#   OPENAI_INPUT_PER_M  OPENAI_OUTPUT_PER_M  USD_INR_FIXED  AI_BATCH_SIZE
#   AI_TOKENS_IN_PER_BATCH  AI_TOKENS_OUT_PER_BATCH  AI_CACHED_TOKENS_PER_BATCH
#
# Reconcile any Discord figure against the OpenAI dashboard with:
#   GET /admin/ai-cost              → today, by pipeline + model
#   GET /admin/ai-cost?days=14      → daily trend

# ============================================================
#  MAIL PIPELINE — read client inboxes, alert clients, Discord ops
#  (src/services/mailPollWorker.js, clientMailNotifier.js, mailClientMonitor.js)
# ============================================================
# Everything is configured in code (classifier=rules, channel=SMTP, one hard-coded
# Discord webhook, hourly scan, 5 AM daily summary). The ONLY runtime inputs are
# the SMTP App-Password credentials below, used to send client milestone alerts
# from the shared Gmail account so a copy is saved to its Sent folder as proof.
#
# Auto-enables on the Render deploy; local runs stay off (they share the prod DB).
# Force locally with MAIL_POLL_ENABLED=1; kill anywhere with MAIL_POLL_ENABLED=0.
# The poller also needs GOOGLE_CLIENT_SECRET (documented above; same var the
# Inbox tab uses).

# Auto-reject: a genuine rejection mail (AI-verified, not low confidence) that
# singles out ONE of the client's applied/interview cards moves that card to
# "rejected by Mail". Ambiguous or unmatched mails change nothing. Notifies nobody.
# ON by default; set MAIL_AUTO_REJECT=off (also 0, false, no, disabled) to stop it.
# Backfill older mail: node scripts/backfill-mail-auto-reject.mjs (dry run) / --apply
# MAIL_AUTO_REJECT=off

# Mail second look on TypeSafe Jev (src/services/mailJevTriage.js). Set the key
# to turn it on; the chat model below becomes the fallback. $0.042 / 1M input
# tokens, output free. URL and model default to the values shown.
# TYPESAFE_API_KEY=
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest
# Jev watch (src/services/mailJevWatch.js + mailJevBackfill.js): per client, from
# Operations > Notifications. Discord webhook for the watch cards; unset, they go
# to the mail channel (ONE_MAIN_DISCORD_FOR_MAIL_NOTIFICATIONS).
# MAIL_JEV_WATCH_WEBHOOK=

# Mail AI provider (Utils/mailAiConfig.js): the second look, the verifier, the
# regex learner. Any OpenAI-compatible chat-completions endpoint. The custom key
# is only ever sent to MAIL_AI_API_URL; without both, OPENAI_API_KEY + OpenAI.
# MAIL_AI_API_URL=https://provider.example/v1/chat/completions
# MAIL_AI_API_KEY=
# MAIL_AI_MODEL=gpt-4o-mini
# Price of MAIL_AI_MODEL in USD per 1M tokens, for the daily Discord cost card.
# Unset = shown at the high fallback rate with a "no price set" warning.
# MAIL_AI_RATE_IN=0.15
# MAIL_AI_RATE_OUT=0.60
# MAIL_AI_RATE_CACHED_IN=0.075

SMTP_USER=      # REQUIRED — full Gmail address, e.g. support@flashfirejobs.com
SMTP_PASS=      # REQUIRED — 16-char Google App Password (NOT the login password)

# ============================================================
# IP geolocation for the Activity Monitor
# ============================================================
#
# Fully in-house: no API key, no bundled database, no build step. Utils/ipGeo.js
# asks three keyless providers (ip-api.com, ipwho.is, ipinfo.io) in parallel and
# keeps the answer they AGREE on. When they agree on the state but not the city
# it reports the state alone rather than guessing between towns.
#
# Every distinct IP is resolved once and stored in the `ip_geo_cache` Mongo
# collection, shared by all instances and surviving restarts, so the free
# providers get a handful of requests a day. GET /health reports hit rates
# under `geo`.
#
# Wrong location? Everything is driveable over HTTP from the deployed service
# (Render gives no shell). All routes need a Bearer JWT with role=admin — the
# same token the Activity Monitor already uses:
#     GET    /admin/geo/top?limit=20        busiest IPs, flagged when shared
#     GET    /admin/geo/inspect/:ip         what each provider said + the verdict
#     POST   /admin/geo/overrides           pin a network to a fixed location
#     DELETE /admin/geo/overrides/:cidr     unpin (use "1.2.3.0-24" for the slash)
#     POST   /admin/geo/backfill            rewrite existing rows (async job)
#     GET    /admin/geo/backfill            job progress
#     GET    /admin/geo/status              cache + resolver health
#
# The same operations exist as CLI scripts for local use:
#     npm run geo:inspect -- 175.111.137.138
#     npm run backfill:location -- --dry-run
#
# There is nothing to configure here. The only related setting:
#
# Set ONLY when the service really is behind an edge that OVERWRITES the header
# (e.g. cf-connecting-ip on Cloudflare). Left blank, the client IP comes from
# Express's `trust proxy` resolution, which a caller cannot forge.
TRUSTED_CLIENT_IP_HEADER=


# ── Mattermost channel provisioning (Utils/mattermostAdmin.js) ──
# Used ONLY to create a client's channel and mint its incoming webhook. Report
# delivery itself goes through the per-client webhook URL, so a rotated bot
# token cannot take every client's reports down at once.
#
# Create the bot: System Console > Integrations > Bot Accounts > Add Bot Account.
# Then grant it a role with:
#   create_private_channel, create_public_channel,
#   manage_private_channel_members, manage_public_channel_members,
#   manage_incoming_webhooks
# manage_incoming_webhooks is NOT granted to bots by default and is the one
# people forget - `npm run mattermost:check` tells you if it is missing.
MATTERMOST_URL=          # e.g. https://mattermost.flashfirejobs.com (no trailing slash)
MATTERMOST_BOT_TOKEN=    # bot personal access token
MATTERMOST_TEAM=         # team URL slug, not the display name


# ── Unsubscribe links (Utils/unsubscribe.js) ──
# Public base URL of THIS api, used to build the one-click unsubscribe link that
# goes in every client-facing mail and in the List-Unsubscribe header Gmail and
# Yahoo require.
#
# OPTIONAL. Unset falls back to the live production API
# (https://flashfire-dashboard-backend.onrender.com), so a forgotten value can
# no longer strip the link out of every mail - which is what used to happen.
# Set it on staging and locally so those point at themselves.
PUBLIC_API_URL=

# Signing key for the unsubscribe token, OPTIONAL.
# Order: UNSUBSCRIBE_SECRET, then CRYPTO_AES_SECRET_SECRET_KEY, then JWT_SECRET.
# Verification accepts any of them, so rotating here does not break links
# already sitting in inboxes.
# It defaults to CRYPTO_AES_SECRET_SECRET_KEY because clients-tracking mails
# clients too and signs with that same key - it is the one secret both services
# provably share. Set this only if you want the two concerns separated, and set
# the SAME value in both services if you do.
UNSUBSCRIBE_SECRET=

# ── Apply-URL policy ────────────────────────────────────────────────────
# Comma-separated hostnames. Both match a host and its subdomains, so
# "dice.com" covers "www.dice.com" but not "notdice.com". Change these and
# restart — adding a portal must never need a code edit.
#
# Job boards and aggregators. A push carrying one of these is refused with
# BLOCKED_SOURCE, telling the operator to supply the real employer URL.
# jobright.ai belongs here: that link means the employer URL never resolved.
BLOCKED_APPLY_HOSTS=jobright.ai,linkedin.com,dice.com,indeed.com
#
# Employers we do not send applications to. These are the employer's OWN
# careers site — the link is fine, the job is skipped by policy, and the
# refusal (EXCLUDED_EMPLOYER) says so rather than blaming the URL.
EXCLUDED_EMPLOYER_HOSTS=lifeattiktok.com,dataannotation.tech,jobs.apple.com,humana.wd5.myworkdayjobs.com,dickssportinggoods.com


# ── Recruiter outreach send days (Utils/businessDays.js) ──
# Recruiter emails go out Monday to Friday only, on every path: the nightly
# cron, the operator "run now" button, bulk compose, and retries of a failed
# send. OPTIONAL: the IANA time zone whose weekday decides the day.
# Unset uses Asia/Kolkata, matching the nightly cron and the once-per-day guard,
# which is the same calendar day as the US recipients at 23:05 IST cron time.
# Set it to America/New_York to judge the day where the recruiters are instead.
# An unrecognised zone fails OPEN (mail still sends) with a warning in the log,
# so a typo cannot silently halt every client's outreach.
RECRUITER_SEND_TIMEZONE=

# SendGrid fallback when the Gmail SMTP login fails (Utils/mailFallback.js).
# Needs SENDGRID_API_KEY. MAIL_FALLBACK=off disables it.
# MAIL_FALLBACK_FROM_EMAIL=noreply@flashfirehq.com
# MAIL_FALLBACK=off
